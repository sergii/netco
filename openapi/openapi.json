          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/coverage/{provider}/checker-interaction": {
      "get": {
        "tags": [
          "Coverage"
        ],
        "operationId": "getCoverageCheckerInteraction",
        "summary": "Get provider coverage checker interaction observation",
        "parameters": [
          {
