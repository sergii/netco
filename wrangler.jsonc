{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netco",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS"
    }
  ],
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "a8f6ce20ac9f4541bf8758cf10eb7948"
    }
  ]
}
