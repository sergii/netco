{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netco.dev/schemas/geo-query.v1.schema.json",
  "title": "Netco Geo Query V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metric",
    "geography"
  ],
  "properties": {
    "schema_version": {
      "const": "geo-query.v1"
    },
    "metric": {
      "type": "string",
      "enum": [
        "competition",
        "fiber_availability",
        "gpon_competition",
        "price",
        "maximum_speed",
        "blackout_resilience",
        "provider_independence",
        "market_opportunity",
        "data_confidence"
      ]
    },
    "geography": {
      "oneOf": [
        {
          "$ref": "#/$defs/cityGeography"
        },
        {
          "$ref": "#/$defs/viewportGeography"
        },
        {
          "$ref": "#/$defs/pointRadiusGeography"
        },
        {
          "$ref": "#/$defs/h3Geography"
        }
      ]
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technology": {
          "type": ["string", "null"],
          "enum": [
            "ethernet",
            "fttb",
            "ftth",
            "gpon",
            "epon",
            "xpon",
            "docsis",
            "dsl",
            "fixed_wireless",
            "other",
            "unknown",
            null
          ]
        },
        "provider_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "residential_only": {
          "type": "boolean"
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "current",
            "effective_at"
          ],
          "default": "current"
        },
        "effective_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_components": {
          "type": "boolean",
          "default": false
        },
        "include_confidence": {
          "type": "boolean",
          "default": true
        },
        "include_supporting_claims": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "cityGeography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "city",
        "h3_resolution"
      ],
      "properties": {
        "type": {
          "const": "city"
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "country_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "h3_resolution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "viewportGeography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "west",
        "south",
        "east",
        "north"
      ],
      "properties": {
        "type": {
          "const": "viewport"
        },
        "west": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "south": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "east": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "north": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "h3_resolution": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "pointRadiusGeography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "latitude",
        "longitude",
        "radius_m"
      ],
      "properties": {
        "type": {
          "const": "point_radius"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "h3Geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cells"
      ],
      "properties": {
        "type": {
          "const": "h3"
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
