    "/api/v1/coverage/addresses": {
      "get": {
        "tags": [
          "Coverage"
        ],
        "operationId": "listCoverageAddresses",
        "summary": "List address coverage inventory",
        "parameters": [
          {
            "name": "freshness",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "fresh",
                "stale"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "400": {
            "$ref": "#/components/responses/JsonBadRequest"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/coverage/address": {
      "get": {
        "tags": [
          "Coverage"
        ],
        "operationId": "getAddressAvailabilityAcrossProviders",
        "summary": "Get address availability across providers",
        "parameters": [
          {
            "$ref": "#/components/parameters/CountryCode"
          },
          {
            "$ref": "#/components/parameters/City"
          },
          {
            "$ref": "#/components/parameters/Street"
          },
          {
            "$ref": "#/components/parameters/HouseNumber"
          },
          {
            "$ref": "#/components/parameters/Region"
          },
          {
            "$ref": "#/components/parameters/District"
          },
          {
            "$ref": "#/components/parameters/Corpus"
          },
          {
            "$ref": "#/components/parameters/BuildingLetter"
          },
          {
            "$ref": "#/components/parameters/PostalCode"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "400": {
            "$ref": "#/components/responses/JsonBadRequest"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/coverage/{provider}/checker-interface": {
      "get": {
        "tags": [
          "Coverage"
        ],
        "operationId": "getCoverageCheckerInterface",
        "summary": "Get provider coverage checker interface observation",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderSlug"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "404": {
