{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netco.dev/schemas/address.v1.schema.json",
  "title": "Netco Address V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "country_code",
    "city",
    "street",
    "house_number"
  ],
  "properties": {
    "schema_version": { "const": "address.v1" },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "region": { "type": ["string", "null"] },
    "city": { "type": "string", "minLength": 1 },
    "district": { "type": ["string", "null"] },
    "street": { "type": "string", "minLength": 1 },
    "house_number": { "type": "string", "minLength": 1 },
    "corpus": { "type": ["string", "null"] },
    "building_letter": { "type": ["string", "null"] },
    "postal_code": { "type": ["string", "null"] },
    "latitude": {
      "type": ["number", "null"],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180
    }
  }
}
