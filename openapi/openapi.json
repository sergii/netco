          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "404": {
            "$ref": "#/components/responses/JsonNotFound"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/coverage/{provider}/address": {
      "get": {
        "tags": [
          "Coverage"
        ],
        "operationId": "getProviderAddressAvailability",
        "summary": "Get address availability for one provider",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderSlug"
          },
          {
            "$ref": "#/components/parameters/CountryCode"
          },
          {
            "$ref": "#/components/parameters/City"
          },
          {
            "$ref": "#/components/parameters/Street"
          },
          {
            "$ref": "#/components/parameters/HouseNumber"
          },
          {
            "$ref": "#/components/parameters/Region"
          },
          {
            "$ref": "#/components/parameters/District"
          },
          {
            "$ref": "#/components/parameters/Corpus"
          },
          {
            "$ref": "#/components/parameters/BuildingLetter"
          },
          {
            "$ref": "#/components/parameters/PostalCode"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "400": {
            "$ref": "#/components/responses/JsonBadRequest"
          },
          "404": {
            "$ref": "#/components/responses/JsonNotFound"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/geo/coverage-points": {
      "get": {
        "tags": [
          "Geo"
        ],
        "operationId": "listCoveragePoints",
        "summary": "Get coverage points as a GeoJSON feature collection",
        "parameters": [
          {
            "name": "geometry",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "present",
                "missing"
              ],
              "default": "all"
            }
          },
          {
            "name": "west",
            "in": "query",
            "required": false,
            "description": "Viewport west longitude",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "south",
            "in": "query",
            "required": false,
            "description": "Viewport south latitude",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": false,
            "description": "Viewport east longitude",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "north",
            "in": "query",
            "required": false,
            "description": "Viewport north latitude",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "400": {
            "$ref": "#/components/responses/JsonBadRequest"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        },
        "description": "Optionally provide west, south, east and north together to restrict persisted coverage points to a WGS84 viewport. Viewport queries do not trigger external collection."
      }
    },
    "/api/v1/geo/enrichment-backlog": {
      "get": {
        "tags": [
          "Geo"
        ],
        "operationId": "getGeoEnrichmentBacklog",
        "summary": "Get geo-enrichment backlog",
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/geo/addresses/{address_id}/provenance": {
      "get": {
        "tags": [
          "Geo",
          "Evidence"
        ],
        "operationId": "getAddressGeoProvenance",
        "summary": "Get trusted coordinate provenance for an address",
        "parameters": [
          {
            "name": "address_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "404": {
            "$ref": "#/components/responses/JsonNotFound"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/geo/h3-cells": {
      "get": {
        "tags": [
          "Geo"
        ],
        "operationId": "listH3CoverageCells",
        "summary": "Aggregate persisted coverage points into deterministic H3 cells",
        "description": "Assigns only already persisted coverage points to H3 cells at the requested resolution. Optional viewport parameters are all-or-nothing and reuse the coverage-point WGS84 bounds. This endpoint performs no external collection or geocoding.",
        "parameters": [
          {
            "name": "resolution",
            "in": "query",
            "required": true,
            "description": "H3 resolution",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            }
          },
          {
            "name": "west",
            "in": "query",
            "required": false,
            "description": "Viewport west longitude",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "south",
            "in": "query",
            "required": false,
            "description": "Viewport south latitude",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": false,
            "description": "Viewport east longitude",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "north",
            "in": "query",
            "required": false,
            "description": "Viewport north latitude",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "400": {
            "$ref": "#/components/responses/JsonBadRequest"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/geo/h3-cells/{h3_index}": {
      "get": {
        "tags": [
          "Geo"
        ],
        "operationId": "inspectH3CoverageCell",
        "summary": "Inspect one persisted H3 coverage cell",
        "description": "Returns persisted address summaries for one H3 cell. It performs no external collection, geocoding, or provider probing. Address coverage and provenance are resolved through their existing read APIs.",
        "parameters": [
          {
            "name": "h3_index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/JsonSuccess"
          },
          "400": {
            "$ref": "#/components/responses/JsonBadRequest"
          },
          "404": {
            "$ref": "#/components/responses/JsonNotFound"
          },
          "503": {
            "$ref": "#/components/responses/JsonUnavailable"
          }
        }
      }
    },
    "/api/v1/operator/addresses/{address_id}": {
      "get": {
        "summary": "Read the internal operator workspace for a persisted address",
        "description": "Composes persisted address, coverage, supporting evidence, geo provenance, freshness, and data-quality state without external collection.",
        "parameters": [
          {
            "name": "address_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operator address workspace"
          },
          "404": {
            "description": "Persisted address not found"
          },
          "503": {
            "description": "Database binding or coverage schema unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JsonObject": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "parameters": {
      "SourceSlug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      },
      "ProviderSlug": {
        "name": "provider",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      },
      "CountryCode": {
        "name": "country_code",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "City": {
        "name": "city",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Street": {
        "name": "street",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "HouseNumber": {
        "name": "house_number",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Region": {
        "name": "region",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "District": {
        "name": "district",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Corpus": {
        "name": "corpus",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "BuildingLetter": {
        "name": "building_letter",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "PostalCode": {
        "name": "postal_code",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "JsonSuccess": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonObject"
            }
          }
        }
      },
      "JsonBadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonObject"
            }
          }
        }
      },
      "JsonNotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonObject"
            }
          }
        }
      },
      "JsonUnavailable": {
        "description": "Required backend capability is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonObject"
            }
          }
        }
      }
    }
  }
}
